# ============================================================
# Leva Já — variáveis do FRONTEND (públicas por natureza: vão para o navegador)
# Copie para .env.local e preencha. NUNCA coloque segredos aqui.
# Sem SUPABASE_URL/ANON_KEY o app roda em MODO DEMO LOCAL (claramente sinalizado).
# ============================================================
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Chave de NAVEGADOR do Google Maps (restrinja por referenciador HTTP e por API no Google Cloud)
VITE_GOOGLE_MAPS_BROWSER_KEY=
# Opcional: Map ID (estilo de mapa na nuvem)
VITE_GOOGLE_MAPS_MAP_ID=
# Força o modo demo mesmo com Supabase configurado (testes)
VITE_FORCE_DEMO=false

# ============================================================
# SEGREDOS DE SERVIDOR — NÃO vão no .env do frontend.
# Configure com: supabase secrets set NOME=valor
#   GOOGLE_ROUTES_SERVER_KEY   chave de servidor da Routes API (restrita por API; sem referenciador)
#   ALLOWED_ORIGINS            https://seu-dominio (lista separada por vírgula)
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY já existem nas Edge Functions.
# ============================================================
